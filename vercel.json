{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/trekloeveret-team-2", "destination": "/cfbb/team-2", "permanent": true }
  ],
  "rewrites": [
    { "source": "/opret", "destination": "/opret.html" },
    { "source": "/aktiver", "destination": "/aktiver.html" },
    { "source": "/kundeadmin", "destination": "/kundeadmin.html" },
    { "source": "/kundeadmin-aktiver", "destination": "/kundeadmin-aktiver.html" },
    { "source": "/saadan-virker-det", "destination": "/saadan-virker-det.html" },
    { "source": "/priser", "destination": "/priser.html" },
    { "source": "/ofte-spurgte-spoergsmaal", "destination": "/ofte-spurgte-spoergsmaal.html" },
    { "source": "/faq", "destination": "/ofte-spurgte-spoergsmaal.html" },
    { "source": "/betingelser", "destination": "/betingelser.html" },
    { "source": "/privatliv", "destination": "/privatliv.html" },
    { "source": "/databehandleraftale", "destination": "/databehandleraftale.html" },
    { "source": "/underdatabehandlere", "destination": "/underdatabehandlere.html" },
    { "source": "/administration", "destination": "/admin" },
    { "source": "/board", "destination": "/board.html" },
    { "source": "/tilbud/:offerSlug", "destination": "/shared-offer" },
    { "source": "/:customerSlug/:boardSlug", "destination": "/board" },
    { "source": "/:teamSlug", "destination": "/app" }
  ],
  "crons": [
    { "path": "/api/renewal-reminders", "schedule": "0 7 * * *" }
  ]
}
